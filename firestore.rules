rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /companies/{uid}  { allow read, write: if request.auth != null && request.auth.uid == uid; }
    match /applicants/{uid} { allow read, write: if request.auth != null && request.auth.uid == uid; }
    match /blueprints/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerUid;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;
    }
    match /screenings/{id} {
      // written as two plain equality checks so Firestore accepts the filtered list queries
      allow read: if request.auth != null
        && (resource.data.applicantUid == request.auth.uid || resource.data.companyUid == request.auth.uid);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.applicantUid;
      allow update: if request.auth != null && request.auth.uid == resource.data.companyUid;
    }
  }
}
